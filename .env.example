# Copy to .env on the server (it is not committed). scripts/server-init.sh fills in WORKER_TOKEN.

# Image builds in mainland China
NPM_REGISTRY=https://registry.npmmirror.com
APK_MIRROR=mirrors.aliyun.com

# Shared secret between api and worker
WORKER_TOKEN=

# Drafting the Chinese listing: any OpenAI-compatible endpoint. Without a key the review page
# still works, the reviewer just writes the listing by hand.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Optional, same endpoint and key: a model that can read images (it may be LLM_MODEL itself, if
# that one can, e.g. glm-5.3-flash). Only used for works whose page has no text to write the blurb
# from; it describes the cover picture.
LLM_VISION_MODEL=

# Optional daily "N works waiting for review" message (feishu | wecom | json)
NOTIFY_WEBHOOK=
NOTIFY_FORMAT=feishu

# Where the site lives, for links in that message
SITE_URL=https://isle.ai-news.top
